# ==============================================================================
# Laya Server Configuration (.env)
# Compatible with both CUDA (docker-compose.yml) and CPU (docker-compose.cpu.yml)
# ==============================================================================

# ------------------------------------------------------------------------------
# Image & Network Ports
# ------------------------------------------------------------------------------
# CUDA Docker Image (default: vinaybalamuru/laya:cuda)
LAYA_IMAGE=vinaybalamuru/laya:cuda

# CPU Docker Image (default: vinaybalamuru/laya:cpu)
LAYA_CPU_IMAGE=vinaybalamuru/laya:cpu

# Host port for CUDA server (docker-compose.yml)
LAYA_PORT=8000

# Host port for CPU server (docker-compose.cpu.yml)
LAYA_CPU_PORT=8112

# Host network bind address:
#   0.0.0.0   = Accessible from all network interfaces (LAN / Remote)
#   127.0.0.1 = Accessible from localhost only
LAYA_BIND_ADDRESS=0.0.0.0

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Optional API Key protection.
# When set, callers to /v1/systemone must supply:
#   Authorization: Bearer <LAYA_API_KEY>
# When empty, the server accepts unauthenticated requests.
LAYA_API_KEY=

# Optional Hugging Face Token (increases rate limits for model downloads)
# Create one at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ------------------------------------------------------------------------------
# Model & Cache Settings
# ------------------------------------------------------------------------------
# Named volume for cached model weights (shared between CPU and CUDA stacks)
LAYA_CACHE_VOLUME=laya_model-cache

# Max models kept resident simultaneously (1 recommended to save memory/VRAM)
LAYA_MAX_LOADED=1

# Preload only the model you need (english, multilingual, or empty for all)
LAYA_MODELS=english

# Preload checkpoints into memory at startup (1 = yes, 0 = on first request)
LAYA_PRELOAD=1

# ------------------------------------------------------------------------------
# Hardware Execution & Precision: CUDA Stack
# ------------------------------------------------------------------------------
# GPU index to reserve (default: 0)
LAYA_GPU_ID=0

# Hardware execution device for CUDA stack
LAYA_DEVICE=cuda

# CUDA autocast precision (fp16, bf16, or empty for checkpoint default)
LAYA_CUDA_AMP=fp16

# ------------------------------------------------------------------------------
# Hardware Execution & Precision: CPU Stack
# ------------------------------------------------------------------------------
# Number of OMP threads for CPU inference (default: 4)
LAYA_CPU_THREADS=4

# Optional CPU autocast precision (bf16 or empty for fp32)
LAYA_CPU_AMP=
