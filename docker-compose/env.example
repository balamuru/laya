# ==============================================================================
# Laya CUDA Server Configuration (.env)
# ==============================================================================

# Target Docker Image (default: vinaybalamuru/laya:cuda)
LAYA_IMAGE=vinaybalamuru/laya:cuda

# Host port to expose
LAYA_PORT=8000

# Host network bind address:
#   0.0.0.0   = Accessible from all network interfaces (LAN / Remote)
#   127.0.0.1 = Accessible from localhost only
LAYA_BIND_ADDRESS=0.0.0.0

# Optional API Key protection.
# When set, callers to /v1/systemone must supply:
#   Authorization: Bearer <LAYA_API_KEY>
# When empty, the server accepts unauthenticated requests.
LAYA_API_KEY=

# Optional Hugging Face Token (increases rate limits for model downloads)
# Create one at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Preload checkpoints into GPU VRAM at startup (1 = yes, 0 = on first request)
LAYA_PRELOAD=1

# GPU index to reserve (default: 0)
LAYA_GPU_ID=0

# Hardware execution device (cuda or cpu)
LAYA_DEVICE=cuda

# Model architecture precision for CUDA autocast (fp16, bf16, or empty for checkpoint default)
LAYA_CUDA_AMP=fp16

# Max models kept resident in GPU VRAM (1 avoids OOM on 8GB GPUs)
LAYA_MAX_LOADED=1

# Preload only the model you need (english, multilingual, or empty for all)
LAYA_MODELS=english

# Named volume for cached model weights
LAYA_CACHE_VOLUME=laya_model-cache
